{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verthill-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": false,
  // Optional later (do not set in this PR): wrangler secret put CHAT_INTERNAL_SECRET
  // Worker/Next fall back to CHAT_AUTH_SECRET until both sides set the new name together.
  // Optional later: wrangler secret put CHAT_PUSH_DISPATCH_URL
  // Example: https://www.verthill.kr/api/chat/push-dispatch
  // Upload grants: wrangler secret put CHAT_MEDIA_SECRET
  // Secret value is not stored in this file.
  "r2_buckets": [
    {
      "binding": "CHAT_MEDIA",
      "bucket_name": "verthill-chat-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      },
      {
        "name": "CHAT_DIRECTORY",
        "class_name": "ChatDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatDirectory"]
    }
  ],
  // Isolated #296 HQ test Worker. Deploy ONLY with: wrangler deploy --env preview296
  // Never bind Production R2/DO. Never run this env from cloudflare-worker-deploy.yml.
  "env": {
    "preview296": {
      "name": "verthill-chat-preview-296",
      "workers_dev": true,
      "preview_urls": false,
      "r2_buckets": [
        {
          "binding": "CHAT_MEDIA",
          "bucket_name": "verthill-chat-media-preview-296"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHAT_ROOM",
            "class_name": "ChatRoom"
          },
          {
            "name": "CHAT_DIRECTORY",
            "class_name": "ChatDirectory"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ChatRoom"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["ChatDirectory"]
        }
      ]
    }
  }
}
