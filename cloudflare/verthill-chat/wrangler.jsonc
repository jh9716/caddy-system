{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verthill-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
