generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssignmentType {
  OFF
  SICK
  LONG_SICK
  DUTY
  MARSHAL
  ACCIDENT
  FAMILY_EVENT
}

enum ShiftPart {
  ONE
  TWO
  THREE
}

enum ShiftVariant {
  NORMAL
  ONE_THREE
  ONE_TWO
  FIFTY_FOUR
}

/// Production DB enum (ACTIVE=재직, LEAVE=휴직, RETIRED=퇴사)
enum EmploymentStatus {
  ACTIVE
  LEAVE
  RETIRED
}

enum CaddyType {
  HOUSE
  THIRD
  DRIVING
}

/// 3부반(9~12조) 주중/주말 세부구분. WEEKEND는 토/일/공휴일 3부 우선에만 사용.
enum ThirdBandSubgroup {
  WEEKDAY
  WEEKEND
}

/// 휴무 신청 workflow 상태 (확정 OFF는 Assignment로만 가용 제외)
enum OffRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Kakao 본인확인(이름+휴대폰) → 관리자 승인 연결 요청 상태
enum CaddyLinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Caddy {
  id                Int              @id @default(autoincrement())
  name              String
  team              String
  /// 조 내 표시 순번 (작을수록 위)
  teamOrder         Int              @default(0)
  employeeCode      String?          @unique
  /// DB: ACTIVE | LEAVE | RETIRED  (UI 라벨: 재직 | 휴직 | 퇴사)
  employmentStatus  EmploymentStatus @default(ACTIVE)
  missingFromImport Boolean          @default(false)
  caddyType         CaddyType        @default(HOUSE)
  /// 3부반 주중반/주말반 (9~12조만). null=일반 3부반 또는 해당 없음. DRIVING 아님.
  thirdBandSubgroup ThirdBandSubgroup?
  /// 레거시 근무 상태 문자열 (가용 배지와 별개, 선택)
  status            String?          @default("근무중")
  /// 주중반 / 주말반 / 드라이빙 등 병행 분류 (레거시 extraFlags — Import 형식 유지)
  extraFlags        String[]         @default([])
  memo              String?
  /// 휴대폰 (canonical: 010XXXXXXXX). null=미등록. PG unique는 NULL 다수 허용.
  phoneNormalized   String?          @unique
  assignments       Assignment[]
  schedules         Schedule[]
  shiftDuties       ShiftDuty[]
  offRequests       OffRequest[]
  dailySpecialDuties DailySpecialDuty[]
  dailyPlacements    DailyPlacement[]
  dailyUnavailables  DailyCaddyUnavailable[]
  dailyOpsDuties     DailyOpsDuty[]
  /// 승인 시 선택된 Caddy로 역참조 (이력). Caddy 물리 삭제 시 selectedCaddyId만 null
  linkRequestSelections CaddyLinkRequest[] @relation("CaddyLinkRequestSelectedCaddy")
  /// 로그인 User와 1:1 (미연결 시 null)
  user              User?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([team, teamOrder])
  @@index([employmentStatus])
  @@index([caddyType])
  @@index([thirdBandSubgroup])
}

model Assignment {
  id        Int             @id @default(autoincrement())
  caddy     Caddy           @relation(fields: [caddyId], references: [id])
  caddyId   Int
  type      AssignmentType
  subType   String?
  startDate DateTime
  endDate   DateTime
  comment   String?
  createdAt DateTime        @default(now())
  /// OffRequest 승인으로 생성된 경우 역링크 (레거시/수동 OFF는 null)
  offRequest OffRequest?
}

model Audit {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int?
  ip        String?
  payload   Json?
  createdAt DateTime @default(now())
}

model DailySchedule {
  id        Int      @id @default(autoincrement())
  date      DateTime
  available Int
  rest      Int
  sick      Int
  longSick  Int
  duty      Int
  marshal   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id      Int      @id @default(autoincrement())
  date    DateTime
  caddyId Int
  memo    String?
  caddy   Caddy    @relation(fields: [caddyId], references: [id])
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  /// ID/PW 계정은 bcrypt 해시. 카카오 OAuth 전용 User는 null (null 시 ID/PW 로그인 거부).
  password  String?
  role      String
  /// 캐디 본인 계정 연결 (기존 User는 null 유지)
  caddyId   Int?     @unique
  caddy     Caddy?   @relation(fields: [caddyId], references: [id])
  /// 조장(leader)이 관리하는 조 목록. 복수 조·공동 조장 가능 (1명=1조 강제 아님). admin은 비워도 전체 접근.
  managedTeams String[] @default([])
  /// 카카오 고유 numeric user id (문자열). 이메일/닉네임/이름 identity 금지. 기존 User backfill 없음.
  kakaoUserId String? @unique
  /// 서명 세션 무효화 카운터. +1 시 해당 User의 기존 signed cookie 전부 거부.
  sessionVersion Int @default(0)
  /// 임시 비밀번호 최초 로그인 후 본인 변경 강제. 기존 User는 false 유지.
  mustChangePassword Boolean @default(false)
  /// 본인확인 연결 요청 이력 (User 물리 삭제는 Restrict로 이력 보호)
  caddyLinkRequests CaddyLinkRequest[]
  createdAt DateTime @default(now())
}

/// Kakao 직원 본인확인 요청 (이름+휴대폰 → 관리자 승인 후 User.caddyId / Caddy.phoneNormalized)
/// 사용자당 PENDING 1건은 migration SQL partial unique:
///   CaddyLinkRequest_userId_pending_key
/// Prisma migrate diff 가 DROP을 제안해도 이 인덱스는 절대 제거하지 말 것.
model CaddyLinkRequest {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// 제출 이름 (표시용). 매칭 키는 앱에서 normalize
  submittedName String
  /// 제출 번호 canonical (010XXXXXXXX). raw 포맷 저장 안 함
  phoneNormalized String
  /// 제출 시점 ACTIVE exact-name 후보 Caddy id 스냅샷
  candidateCaddyIds Int[] @default([])

  /// 승인 시 확정 Caddy. PENDING/REJECTED/CANCELLED에서는 null
  selectedCaddyId Int?
  selectedCaddy   Caddy? @relation("CaddyLinkRequestSelectedCaddy", fields: [selectedCaddyId], references: [id], onDelete: SetNull)

  status CaddyLinkRequestStatus @default(PENDING)

  requestedAt DateTime @default(now())
  decidedAt   DateTime?
  /// OffRequest.decidedByUserId 와 동일: FK 없음 (admin User 삭제와 이력 분리)
  decidedByUserId Int?
  decisionNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([userId, status])
  @@index([phoneNormalized])
  @@index([decidedByUserId])
}

model ShiftDuty {
  id      Int          @id @default(autoincrement())
  date    DateTime
  part    ShiftPart
  variant ShiftVariant @default(NORMAL)

  orderNo Int
  caddyId Int
  team    String?
  caddy   Caddy       @relation(fields: [caddyId], references: [id])

  createdAt DateTime  @default(now())

  @@index([date, part])
}

model ScheduleExtraTag {
  id        Int      @id @default(autoincrement())
  date      DateTime
  caddyId   Int
  tag       String

  createdBy String?
  createdAt DateTime @default(now())

  @@unique([date, caddyId, tag])
  @@index([date, caddyId])
}

/// 휴무 신청 이력 (row 삭제 금지 — 운영 감사 보존)
/// 활성 중복(REQUESTED|APPROVED)은 migration SQL의 partial unique index로 방지:
///   OffRequest_caddyId_date_active_key
model OffRequest {
  id               Int              @id @default(autoincrement())
  caddyId          Int
  caddy            Caddy            @relation(fields: [caddyId], references: [id])
  /// 휴무 대상일 (로컬 자정으로 normalize)
  date             DateTime
  status           OffRequestStatus @default(REQUESTED)
  requestedAt      DateTime         @default(now())
  note             String?

  /// 승인/반려 시점·처리자 (승인 후 revoke 되어도 유지 — 감사)
  decidedAt        DateTime?
  decidedByUserId  Int?
  decisionNote     String?

  /// APPROVED 시 생성된 Assignment(OFF). revoke 시 null로 해제(Assignment 삭제)
  assignmentId     Int?             @unique
  assignment       Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([date, status])
  @@index([caddyId, date])
  @@index([caddyId, status])
  @@index([decidedByUserId])
}

/// 날짜별 관리자 특수근무 입력 (캐디 본인 신청 아님)
/// 같은 날짜·유형 안 sortOrder = 입력 순서(우선순위). team/teamOrder는 변경하지 않음.
enum DailySpecialKind {
  ONE_MAK
  ONE_TWO
  ONE_THREE
  FIFTY_FOUR
  CHAGEUN
}

model DailySpecialDuty {
  id        Int              @id @default(autoincrement())
  date      DateTime
  kind      DailySpecialKind
  caddyId   Int
  caddy     Caddy            @relation(fields: [caddyId], references: [id])
  /// 1부터. 같은 date+kind 안에서 작을수록 먼저 배치
  sortOrder Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, kind, caddyId])
  @@index([date, kind, sortOrder])
  @@index([caddyId])
}

/// 1·3부 / 1막 1부 시작 예약 (코스+티타임). 54홀·1·2부는 사용하지 않음.
model DailySpecialDutyAnchor {
  id        Int              @id @default(autoincrement())
  date      DateTime
  kind      DailySpecialKind
  course    String
  teeTime   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, kind])
  @@index([date])
}

/// 해당 월~일 주에만 적용되는 3부반 시작조 수동 지정.
/// 없으면 2026-08-17=12조 기준 자동 순환. 다음 주로 이월되지 않음.
model ThirdWeeklyStartOverride {
  id        Int      @id @default(autoincrement())
  /// 그 주 월요일 00:00
  weekStart DateTime
  /// "9조" | "10조" | "11조" | "12조"
  startTeam String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekStart])
}

/// 당일 예약 영속 (자동배치 Excel + 당추). Production migrate는 별도 승인.
enum DailyReservationStatus {
  ACTIVE
  CANCELLED
  TEAM_NOSHOW
}

model DailyReservation {
  id           Int                    @id @default(autoincrement())
  date         DateTime
  course       String
  shift        String
  teeTime      String
  teamName     String?
  hole         Int?
  source       String?
  status       DailyReservationStatus @default(ACTIVE)
  identityKey  String
  rawRowIndex  Int?
  /// 리무진카트 요청팀. 캐디 속성이 아니라 예약팀 속성.
  limousineCart Boolean               @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  placements   DailyPlacement[]

  @@unique([date, identityKey])
  @@index([date, status])
  @@index([date, course, teeTime])
}

model DailyPlacement {
  id             Int              @id @default(autoincrement())
  date           DateTime
  reservationId  Int
  reservation    DailyReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  caddyId        Int
  caddy          Caddy            @relation(fields: [caddyId], references: [id])
  kind           String
  reason         String?
  sequenceIndex  Int              @default(0)
  pairId         String?
  /// true=특수 LOCK ON (해당 reservation 고정)
  locked         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([reservationId])
  @@index([date, caddyId])
  @@index([date, locked])
}

/// 당일 당번·마샬·조장 운영 일정 (Excel 파싱 결과). 자동배치/reflow 후보 제외에 사용.
/// ShiftDuty(확정 배치표) · DailySpecialDuty(1막/1·3 등) · Assignment(기간지정)와 분리.
enum DailyOpsDutyRole {
  DUTY_AM
  DUTY_PM
  MARSHAL_AM
  MARSHAL_PM
  LEADER
}

model DailyOpsDuty {
  id        Int             @id @default(autoincrement())
  date      DateTime
  role      DailyOpsDutyRole
  /// 파일 A열 키. 예: 당번_조출_1. 같은 날짜에 슬롯 1개.
  roleKey   String
  caddyId   Int
  caddy     Caddy           @relation(fields: [caddyId], references: [id])
  /// 파일에서 읽은 원본 이름 (표시·감사)
  rawName   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([date, roleKey])
  @@unique([date, role, caddyId])
  @@index([date, caddyId])
  @@index([caddyId])
}

enum DailyCaddyUnavailableReason {
  SICK
  ATTENDANCE_NOSHOW
}

/// 해당 날짜만 임시 비가용. Caddy.employmentStatus는 변경하지 않음.
model DailyCaddyUnavailable {
  id        Int                          @id @default(autoincrement())
  date      DateTime
  caddyId   Int
  caddy     Caddy                        @relation(fields: [caddyId], references: [id])
  reason    DailyCaddyUnavailableReason
  note      String?
  /// 병가가 적용되는 첫 부. "1부"|"2부"|"3부". null = 기존 종일 제외.
  effectiveFromShift String?
  createdAt DateTime                     @default(now())

  @@unique([date, caddyId])
  @@index([caddyId])
}

enum DailyAssignmentChangeType {
  CANCEL_RESERVATION
  TEAM_NOSHOW
  CADDY_SICK
  CADDY_ATTENDANCE_NOSHOW
  ADD_RESERVATION
  SWAP_CADDY
  SET_LIMOUSINE
  ASSIGN_DRIVING
  CLEAR_DRIVING
}

/// 현장 배치 변경 이력. preview는 저장하지 않고 apply 시에만 row 생성.
model DailyAssignmentChange {
  id          Int                       @id @default(autoincrement())
  date        DateTime
  changeType  DailyAssignmentChangeType
  /// CANCEL vs TEAM_NOSHOW 등 동일 reflow의 사유 구분
  cause       String?
  payload     Json?
  appliedAt   DateTime                  @default(now())
  createdAt   DateTime                  @default(now())

  @@index([date, appliedAt])
}
